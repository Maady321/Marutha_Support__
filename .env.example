# Base Environment
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/ashwasa_support?schema=public"

# Authentication (Server-only)
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_REFRESH_SECRET=replace_with_another_secure_string_in_production

# Storage
STORAGE_PROVIDER=cloudinary
STORAGE_BUCKET=ashwasa_support_assets
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Email Notifications
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user
SMTP_PASS=password
